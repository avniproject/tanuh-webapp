# --- Dev ---
# Leave VITE_AVNI_API_BASE_URL empty so browser requests go same-origin to the
# Vite dev server, which proxies them upstream to VITE_AVNI_PROXY_TARGET.
# Avoids CORS in development.
VITE_AVNI_API_BASE_URL=
VITE_AVNI_PROXY_TARGET=https://staging.avniproject.org

# --- Production ---
# When the built bundle is served from the same origin as the Avni server,
# leave VITE_AVNI_API_BASE_URL empty. Only set it if you must call a different
# origin AND that origin has CORS configured for this app's host.

# --- Data quality service (the Data Quality screens) ---
# The app calls DQS under VITE_DQS_API_BASE_URL, "/dqs" when unset. In development the dev
# server forwards /dqs to VITE_DQS_PROXY_TARGET, such as a local DQS on port 8000 or the
# staging service. In production, either the host serving this app forwards /dqs to DQS, or
# VITE_DQS_API_BASE_URL names DQS's address and DQS allows this app's origin.
VITE_DQS_API_BASE_URL=
VITE_DQS_PROXY_TARGET=http://127.0.0.1:8000
VITE_DQS_TENANT=samvit
