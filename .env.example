# --- Dev ---
# Leave VITE_AVNI_API_BASE_URL empty so browser requests go same-origin to the
# Vite dev server, which proxies them upstream to VITE_AVNI_PROXY_TARGET.
# Avoids CORS in development.
VITE_AVNI_API_BASE_URL=
VITE_AVNI_PROXY_TARGET=https://staging.avniproject.org

# --- Production ---
# When the built bundle is served from the same origin as the Avni server,
# leave VITE_AVNI_API_BASE_URL empty. Only set it if you must call a different
# origin AND that origin has CORS configured for this app's host.
